{
  "hooks": {
    "beforeShellExecution": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/guard.sh",
            "timeout": 10,
            "env": { "MODE": "strict" }
          }
        ]
      }
    ],
    "afterFileEdit": [
      {
        "hooks": [
          { "type": "http", "url": "https://hooks.example.com/notify", "env": null }
        ]
      }
    ]
  },
  "permissions": { "allow": ["Bash(npm run build)"] },
  "model": "grok-4"
}
